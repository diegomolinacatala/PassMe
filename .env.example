# =============================================================================
# PassMe — variables de entorno
# Copia este archivo a .env.local (local) y pon los mismos valores en Vercel
# (Project → Settings → Environment Variables). Guía completa: docs/SETUP.md
# Comprueba tu configuración con:  npm run doctor
# =============================================================================

# --- Sitio -------------------------------------------------------------------
# URL pública SIN barra final. Es la que va dentro del QR de los pases, así que
# en producción pon tu dominio definitivo (https://...).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email de contacto que aparece en /privacidad
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (obligatorio para salir del modo demo) --------------------------
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave "publishable" (sb_publishable_...) — o la antigua "anon" en NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave "secret" (sb_secret_...) — o la antigua "service_role" en SUPABASE_SERVICE_ROLE_KEY.
# SOLO servidor: nunca con prefijo NEXT_PUBLIC_. Necesaria para pases, métricas y borrar cuentas.
SUPABASE_SECRET_KEY=
# Muestra el botón "Continuar con Google" en el login (configura antes el proveedor en Supabase)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Enlaces "enviar el pase a mi móvil" ----------------------------------------
# Mínimo 32 caracteres aleatorios. Genera uno con:  openssl rand -base64 48
PASSME_SIGNING_SECRET=

# --- Apple Wallet (opcional hasta tener cuenta de Apple Developer) -------------
# Identificadores de developer.apple.com → Certificates, IDs & Profiles
APPLE_PASS_TYPE_ID=pass.com.tudominio.passme
APPLE_TEAM_ID=ABCDE12345
# Certificados en PEM, pegados en base64 (una sola línea). El script los prepara:
#   bash scripts/apple-certs.sh env
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
# Actualizaciones automáticas de pases (push). Requiere https + SUPABASE_SECRET_KEY.
# Pon "false" para desactivarlas.
APPLE_WALLET_WEB_SERVICE=true
# APNs: producción por defecto. Para pruebas: https://api.sandbox.push.apple.com
APPLE_APNS_HOST=

# --- Google Wallet (opcional) ---------------------------------------------------
# pay.google.com/business/console → Google Wallet API → Issuer ID
GOOGLE_WALLET_ISSUER_ID=
# JSON de la cuenta de servicio (entero o en base64):  base64 -w0 service-account.json
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Alternativa al JSON:
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
# Sube la versión para estrenar un diseño de clase nuevo (passme_card_v2, ...)
GOOGLE_WALLET_CLASS_SUFFIX=passme_card_v1
